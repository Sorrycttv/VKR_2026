<?xml version="1.0" encoding="utf-8"?>

<!--
    ScrollView позволяет прокручивать форму,
    если она не помещается на небольшом экране.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FAF5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NutriPlan"
            android:textColor="#1B1C1B"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Регистрация"
            android:textColor="#1B1C1B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Электронная почта"
            android:inputType="textEmailAddress"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Пароль"
            android:inputType="textPassword"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/repeatPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Повторите пароль"
            android:inputType="textPassword"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#28764F"
            android:text="Зарегистрироваться"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- Переход на экран входа для существующего пользователя. -->
        <TextView
            android:id="@+id/loginText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12dp"
            android:text="Уже зарегистрированы? Войти"
            android:textColor="#28764F"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
